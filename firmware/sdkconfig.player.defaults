# Stable player: pinned loader, private zero-import native modules only.
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ELF_LOADER_LIBC_SYMBOLS=n
CONFIG_ELF_LOADER_ESPIDF_SYMBOLS=n
CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS=n
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=n
CONFIG_ELF_LOADER_NUMBER_SYMBOLS=1
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
