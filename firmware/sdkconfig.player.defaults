# Stable player: pinned loader, private zero-import native modules only.
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ELF_LOADER_LIBC_SYMBOLS=n
CONFIG_ELF_LOADER_ESPIDF_SYMBOLS=n
CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS=n
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=n
CONFIG_ELF_LOADER_NUMBER_SYMBOLS=1
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Wi-Fi is STA-only and its credentials live solely in the player-owned blob.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
