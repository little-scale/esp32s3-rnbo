@state left = new biquad();
@state right = new biquad();
@state sampleIndex: Int = 0;
if(sampleIndex%257==37 || sampleIndex%257==38 || sampleIndex==255 || sampleIndex==256){left.clear();}
if(sampleIndex%263==91 || sampleIndex%263==92 || sampleIndex==511 || sampleIndex==512){right.clear();}
out1=left.next(in1,.5,.25,.125,-.25,.125)+0*in1; out2=right.next(in2,.5,.25,.125,-.25,.125)+0*in2;
sampleIndex+=1;
