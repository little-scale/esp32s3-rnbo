@state left=new rampsmooth(); @state right=new rampsmooth();
@state ordinal: Int=0;
if(ordinal%257==37 || ordinal%257==38 || ordinal==255 || ordinal==256){left.reset();}
if(ordinal%263==91 || ordinal%263==92 || ordinal==511 || ordinal==512){right.reset();}
out1=left.next(ordinal%1021<333?1:(ordinal%1021<701?-.5:.25),8,8)+0*in1; out2=right.next(ordinal%1031<347?-1:(ordinal%1031<739?.5:-.25),16,16)+0*in2;
