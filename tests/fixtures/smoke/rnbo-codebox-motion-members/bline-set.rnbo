@state left=new bline(); @state right=new bline();
@state ordinal: Int=0;
if(ordinal%257==37 || ordinal%257==38 || ordinal==255 || ordinal==256){left.set(.5);}
if(ordinal%263==91 || ordinal%263==92 || ordinal==511 || ordinal==512){right.set(-.5);}
let a=left.next(ordinal%1021<333?1:(ordinal%1021<701?-.5:.25),8); let b=right.next(ordinal%1031<347?-1:(ordinal%1031<739?.5:-.25),16); out1=a[0]+0*in1; out2=b[0]+0*in2;
ordinal+=1;
