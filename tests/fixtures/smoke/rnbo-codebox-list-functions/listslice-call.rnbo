function score(values:list):number {
    let total = 100*values.length;
    for (let i:Int=0; i<values.length; i++) { total += (i+1)*values[i]; }
    return total;
}
let a:list = [in1,2,3,2,5];
let b:list = [in2,2,9];
let result=listslice(a,in2); out1=score(result[0])+0*in1; out2=score(result[1])+0*in2;
