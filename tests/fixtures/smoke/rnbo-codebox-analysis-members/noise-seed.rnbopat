          "rnbo_extra_attributes": {
            "code": "@state left = new noise();\n@state right = new noise();\n@state ordinal: Int = 0;\n@state previousA=0; @state previousB=0; @state changesA=0; @state changesB=0; @state status=1;\nif(ordinal==0 || ordinal%257==19 || ordinal%257==20){left.seed(12345); right.seed(12345);}\nlet a=left.next(); let b=right.next(); changesA+=(a!=previousA); changesB+=(b!=previousB);\nif(ordinal%32==31){status=changesA>0 && changesB>0; changesA=0; changesB=0;}\nout1=(a>=-1 && a<=1 && b>=-1 && b<=1)+0*in1; out2=status && a==b+0*in2;\npreviousA=a; previousB=b;\nordinal+=1;\n"
          },
          "rnbo_uniqueid": "code",
          "text": "codebox~"
        }
