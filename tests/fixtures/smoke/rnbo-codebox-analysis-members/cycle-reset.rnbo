@state left = new cycle();
@state right = new cycle();
@state ordinal: Int = 0;
if(ordinal%257==37 || ordinal%257==38 || ordinal==255 || ordinal==256){left.reset();}
if(ordinal%263==91 || ordinal%263==92 || ordinal==511 || ordinal==512){right.reset();}
let a=left.next(44100/512,0); let b=right.next(44100/1024,.25);
out1=a[0]+0*in1; out2=b[0]+0*in2;
ordinal+=1;
