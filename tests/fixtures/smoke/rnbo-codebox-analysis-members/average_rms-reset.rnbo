@state left = new average_rms();
@state right = new average_rms();
@state ordinal: Int = 0;
if(ordinal%257==37 || ordinal%257==38 || ordinal==255 || ordinal==256){left.reset();}
if(ordinal%263==91 || ordinal%263==92 || ordinal==511 || ordinal==512){right.reset();}
let wl=8; let wr=16;
out1=left.next(in1,wl,false); out2=right.next(in2,wr,false);
ordinal+=1;
